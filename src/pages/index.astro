<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Catálogo CASIO</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: #f5f5f5;
				height: 100dvh;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}

			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 12px 20px;
				background: white;
				border-bottom: 1px solid #ddd;
				flex-wrap: wrap;
				gap: 10px;
			}

			.header h1 {
				font-size: 18px;
				margin: 0;
				flex: 1;
			}

			a {
				background: #10b981;
				color: white;
				padding: 8px 14px;
				border-radius: 4px;
				text-decoration: none;
				font-size: 13px;
				font-weight: 600;
				display: inline-block;
			}

			#pdfViewer {
				flex: 1;
				width: 100%;
				border: none;
			}
		</style>
	</head>
	<body>
		<div class="header">
			<h1>📄 Catálogo CASIO</h1>
			<a href="/catalogo_casio_precios.pdf" download>⬇ Descargar PDF</a>
		</div>

		<embed id="pdfViewer" src="/catalogo_casio_precios.pdf" type="application/pdf" />
	</body>
</html>
