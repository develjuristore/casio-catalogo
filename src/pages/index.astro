<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Catálogo CASIO</title>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: #f5f5f5;
				color: #333;
				height: 100dvh;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}

			.toolbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 12px 20px;
				background: white;
				border-bottom: 1px solid #ddd;
				flex-wrap: wrap;
				gap: 10px;
			}

			.toolbar-left, .toolbar-center, .toolbar-right {
				display: flex;
				align-items: center;
				gap: 10px;
			}

			.toolbar-center {
				flex: 1;
				justify-content: center;
			}

			button {
				background: #0066cc;
				color: white;
				border: none;
				padding: 8px 14px;
				border-radius: 4px;
				cursor: pointer;
				font-size: 13px;
				font-weight: 600;
				transition: all 0.2s ease;
			}

			button:hover:not(:disabled) {
				background: #0052a3;
				transform: translateY(-1px);
			}

			button:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			.page-input {
				width: 50px;
				padding: 6px 10px;
				border: 1px solid #ddd;
				border-radius: 4px;
				background: #f5f5f5;
				color: #333;
				font-size: 13px;
				text-align: center;
			}

			.page-info {
				font-size: 12px;
				color: #666;
				font-weight: 500;
			}

			.controls-group {
				display: flex;
				align-items: center;
				gap: 6px;
			}

			.zoom-value {
				font-size: 12px;
				color: #666;
				min-width: 40px;
				text-align: center;
			}

			#pdfContainer {
				flex: 1;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 10px;
				background: #f5f5f5;
				overflow: auto;
				width: 100%;
				height: 100%;
			}

			#pdfCanvas {
				max-width: 90vw;
				max-height: 90dvh;
				width: auto;
				height: auto;
				box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
				animation: pageFlip 0.5s ease-in-out;
				cursor: grab;
			}

			#pdfCanvas:active {
				cursor: grabbing;
			}

			@keyframes pageFlip {
				0% {
					opacity: 0;
					transform: rotateY(90deg);
				}
				50% {
					opacity: 0.7;
				}
				100% {
					opacity: 1;
					transform: rotateY(0deg);
				}
			}

			.loading {
				text-align: center;
				padding: 20px;
				color: #666;
			}
		</style>
	</head>
	<body>
		<div class="toolbar">
			<div class="toolbar-left">
				<button id="prevBtn">◀ Anterior</button>
				<button id="nextBtn">Siguiente ▶</button>
			</div>

			<div class="toolbar-center">
				<input type="number" id="pageInput" class="page-input" min="1" />
				<span class="page-info">de <span id="totalPages">0</span> págs</span>
			</div>

			<div class="toolbar-right">
				<div class="controls-group">
					<button id="zoomOut">−</button>
					<span class="zoom-value" id="zoomValue">100%</span>
					<button id="zoomIn">+</button>
					<button id="resetZoom">⟲</button>
				</div>
				<a id="downloadBtn" style="background: #10b981; color: white; padding: 8px 14px; border-radius: 4px; text-decoration: none; font-size: 13px; font-weight: 600; cursor: pointer;">⬇ Descargar</a>
			</div>
		</div>

		<div id="pdfContainer">
			<canvas id="pdfCanvas"></canvas>
		</div>

		<script>
			// URL del PDF desde CloudFlare R2 CDN
			const PDF_URL = 'https://pub-9d3a5c326453460d83ad0565c02e3b18.r2.dev/catalogo_casio_precios_compressed.pdf';

			pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

			let pdfDoc = null;
			let currentPage = 1;
			let zoom = 1;
			let canvas = document.getElementById('pdfCanvas');
			let ctx = canvas.getContext('2d');
			const container = document.getElementById('pdfContainer');
			const pageCache = new Map(); // Cache de páginas renderizadas
			let isRendering = false;

			async function loadPdf() {
				try {
					pdfDoc = await pdfjsLib.getDocument(PDF_URL).promise;
					document.getElementById('totalPages').textContent = pdfDoc.numPages;
					document.getElementById('pageInput').max = pdfDoc.numPages;
					renderPage(1);
				} catch (error) {
					container.innerHTML = `<div class="loading" style="color: red;">Error al cargar PDF: ${error.message}</div>`;
				}
			}

			async function renderPage(pageNum) {
				if (!pdfDoc || pageNum < 1 || pageNum > pdfDoc.numPages || isRendering) return;

				isRendering = true;

				try {
					// Verificar si está en cache
					const cacheKey = `${pageNum}-${Math.round(zoom * 100)}`;
					if (pageCache.has(cacheKey)) {
						const cachedCanvas = pageCache.get(cacheKey);
						container.innerHTML = '';
						container.appendChild(cachedCanvas.cloneNode(true));
						currentPage = pageNum;
						document.getElementById('pageInput').value = pageNum;
						isRendering = false;
						// Precargar páginas adyacentes
						preloadAdjacentPages(pageNum);
						return;
					}

					container.innerHTML = '<div class="loading">Cargando página...</div>';

					const page = await pdfDoc.getPage(pageNum);
					const viewport = page.getViewport({ scale: zoom });

					canvas.width = viewport.width;
					canvas.height = viewport.height;

					await page.render({
						canvasContext: ctx,
						viewport: viewport
					}).promise;

					// Guardar en cache (máximo 10 páginas)
					if (pageCache.size > 10) {
						const firstKey = pageCache.keys().next().value;
						pageCache.delete(firstKey);
					}
					pageCache.set(cacheKey, canvas.cloneNode(true));

					currentPage = pageNum;
					document.getElementById('pageInput').value = pageNum;
					container.innerHTML = '';
					container.appendChild(canvas);

					// Precargar páginas adyacentes en background
					preloadAdjacentPages(pageNum);
				} catch (error) {
					container.innerHTML = `<div class="loading" style="color: #999;">No se pudo renderizar la página ${pageNum}</div>`;
				} finally {
					isRendering = false;
				}
			}

			async function preloadAdjacentPages(pageNum) {
				// Precargar página siguiente
				if (pageNum < pdfDoc.numPages) {
					const nextKey = `${pageNum + 1}-${Math.round(zoom * 100)}`;
					if (!pageCache.has(nextKey)) {
						try {
							const page = await pdfDoc.getPage(pageNum + 1);
							const tempCanvas = document.createElement('canvas');
							const tempCtx = tempCanvas.getContext('2d');
							const viewport = page.getViewport({ scale: zoom });
							tempCanvas.width = viewport.width;
							tempCanvas.height = viewport.height;
							await page.render({ canvasContext: tempCtx, viewport }).promise;
							pageCache.set(nextKey, tempCanvas);
						} catch (e) {}
					}
				}
				// Precargar página anterior
				if (pageNum > 1) {
					const prevKey = `${pageNum - 1}-${Math.round(zoom * 100)}`;
					if (!pageCache.has(prevKey)) {
						try {
							const page = await pdfDoc.getPage(pageNum - 1);
							const tempCanvas = document.createElement('canvas');
							const tempCtx = tempCanvas.getContext('2d');
							const viewport = page.getViewport({ scale: zoom });
							tempCanvas.width = viewport.width;
							tempCanvas.height = viewport.height;
							await page.render({ canvasContext: tempCtx, viewport }).promise;
							pageCache.set(prevKey, tempCanvas);
						} catch (e) {}
					}
				}
			}

			document.getElementById('prevBtn').addEventListener('click', () => {
				if (currentPage > 1) renderPage(currentPage - 1);
			});

			document.getElementById('nextBtn').addEventListener('click', () => {
				if (pdfDoc && currentPage < pdfDoc.numPages) renderPage(currentPage + 1);
			});

			document.getElementById('pageInput').addEventListener('change', (e) => {
				const pageNum = parseInt(e.target.value) || 1;
				if (pageNum > 0 && pdfDoc && pageNum <= pdfDoc.numPages) {
					renderPage(pageNum);
				}
			});

			document.getElementById('zoomIn').addEventListener('click', () => {
				zoom = Math.min(zoom + 0.25, 5);
				document.getElementById('zoomValue').textContent = Math.round(zoom * 100) + '%';
				renderPage(currentPage);
			});

			document.getElementById('zoomOut').addEventListener('click', () => {
				zoom = Math.max(zoom - 0.25, 0.5);
				document.getElementById('zoomValue').textContent = Math.round(zoom * 100) + '%';
				renderPage(currentPage);
			});

			// Zoom con rueda del mouse
			document.getElementById('pdfContainer').addEventListener('wheel', (e) => {
				if (e.ctrlKey) {
					e.preventDefault();
					const delta = e.deltaY > 0 ? -0.1 : 0.1;
					zoom = Math.max(0.5, Math.min(5, zoom + delta));
					document.getElementById('zoomValue').textContent = Math.round(zoom * 100) + '%';
					renderPage(currentPage);
				}
			}, { passive: false });

			document.getElementById('resetZoom').addEventListener('click', () => {
				zoom = 1;
				document.getElementById('zoomValue').textContent = '100%';
				renderPage(currentPage);
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight') document.getElementById('nextBtn').click();
				if (e.key === 'ArrowLeft') document.getElementById('prevBtn').click();
			});

			// Soporte táctil para deslizar
			let touchStartX = 0;
			let touchEndX = 0;

			container.addEventListener('touchstart', (e) => {
				touchStartX = e.changedTouches[0].screenX;
			}, false);

			container.addEventListener('touchend', (e) => {
				touchEndX = e.changedTouches[0].screenX;
				handleSwipe();
			}, false);

			function handleSwipe() {
				const swipeThreshold = 50; // Mínimo de píxeles para registrar desliz
				const diff = touchStartX - touchEndX;

				if (Math.abs(diff) > swipeThreshold) {
					if (diff > 0) {
						// Desliz hacia la izquierda = siguiente página
						if (pdfDoc && currentPage < pdfDoc.numPages) {
							renderPage(currentPage + 1);
						}
					} else {
						// Desliz hacia la derecha = página anterior
						if (currentPage > 1) {
							renderPage(currentPage - 1);
						}
					}
				}
			}

			// Botón descargar
			document.getElementById('downloadBtn').addEventListener('click', () => {
				const link = document.createElement('a');
				link.href = PDF_URL;
				link.download = 'catalogo_casio_precios.pdf';
				document.body.appendChild(link);
				link.click();
				document.body.removeChild(link);
			});

			loadPdf();
		</script>
	</body>
</html>
